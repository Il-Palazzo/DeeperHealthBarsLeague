# ============================================================
# DeeperHealthBarsLeague .gitignore
# ============================================================

# ----- OS-generated files -----
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# ----- Python / Jupyter caches -----
__pycache__/
*.pyc
*.pyo
.ipynb_checkpoints/

# ----- Environment & secrets -----
# Riot Games API keys, .env files, and local credentials
.env
.env.*
*.secret
*.key

# ----- YOLO / ML training outputs -----
# Runs directory contains logs, checkpoints, and evaluation plots
LolHealth-Bar/runs/
runs/

# ----- Raw Gameplay Screenshots -----
# Exclude raw game captures while preserving folder structure
LolHealth-Bar/Screenshots/*
!LolHealth-Bar/Screenshots/.gitkeep
!LolHealth-Bar/Screenshots/README.md

# ----- Synthetic Training Dataset -----
# Exclude generated training images, labels, and YAML splits
LolHealth-Bar/synthetic_dataset/images/*
!LolHealth-Bar/synthetic_dataset/images/.gitkeep
LolHealth-Bar/synthetic_dataset/labels/*
!LolHealth-Bar/synthetic_dataset/labels/.gitkeep
LolHealth-Bar/synthetic_dataset/split/
LolHealth-Bar/synthetic_dataset/*.yaml
LolHealth-Bar/synthetic_dataset/*.csv

# Any future yolo_training_data directory
LolHealth-Bar/yolo_training_data/

# ----- Intermediate / working crops -----
# Intermediate health-bar crops and staging directories
LolHealth-Bar/To_Classify/
LolHealth-Bar/crops/*
!LolHealth-Bar/crops/.gitkeep
LolHealth-Bar/perfect_crops/

# ----- Model weight files -----
# PyTorch .pt weights (~17-18 MB each) should be hosted via GitHub Releases
*.pt

# ----- Loose ad-hoc captures -----
LolHealth-Bar/Screenshot *.png
LolHealth-Bar/mac_raw_capture.jpg

# ----- Proprietary Fonts -----
# BeaufortForLoL is Riot Games proprietary font; excluded to respect IP
LolHealth-Bar/Classified/Fonts/
